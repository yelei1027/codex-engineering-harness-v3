FROM node@sha256:5736e7ef1f3f2109be7ef8aea0cbdf931804aee9a18c6760507b8ded078b25a9 AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install --global pnpm@10.32.1
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build
FROM node@sha256:5736e7ef1f3f2109be7ef8aea0cbdf931804aee9a18c6760507b8ded078b25a9
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist ./dist
COPY harness-frontend-server.mjs ./server.mjs
USER node
EXPOSE 5173
CMD ["node", "server.mjs"]
